@@ -124,0 +126,18 @@ bool DYSMC::addTachometerKey(OSString *name, UInt8 fan) {
+bool DYSMC::addHPWmiFanKey(UInt8 fan) {
+    UInt32 rpm = 0;
+    if (!fanProvider || sensorCount >= MAX_SENSOR ||
+        fanProvider->readThinkFanRPM(0, rpm) != kIOReturnSuccess || rpm > 20000)
+        return false;
+
+    if (!VirtualSMCAPI::addKey(KeyF0Ac(fan), vsmcPlugin.data,
+                               VirtualSMCAPI::valueWithFp(0, SmcKeyTypeFpe2,
+                                                          new atomicFpKey(&currentSensor[sensorCount]))))
+        return false;
+
+    sensorType[sensorCount] = SENSOR_TYPE_HP_WMI_FAN;
+    sensorIndex[sensorCount] = 0;
+    atomic_store_explicit(&currentSensor[sensorCount], rpm, memory_order_release);
+    ++sensorCount;
+    return true;
+}

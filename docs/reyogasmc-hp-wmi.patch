--- a/ReYogaSMC/Platform/DYVPC.cpp
+++ b/ReYogaSMC/Platform/DYVPC.cpp
@@ -133,3 +133,34 @@ void DYVPC::updateVPC(UInt32 event) {
-    if (id == HPWMI_BEZEL_BUTTON)
-        DebugLog("Bezel id: 0x%x - 0x%x", id, data);
-    else
+    if (id == HPWMI_BEZEL_BUTTON) {
+        struct HotkeyContext {
+            UInt32 keyCode{0};
+        } context;
+
+        IOReturn status = kIOReturnNotReady;
+        if (commandGate) {
+            status = commandGate->runAction(
+                [](OSObject *owner, void *argument, void *, void *, void *) -> IOReturn {
+                    auto self = OSDynamicCast(DYVPC, owner);
+                    auto context = static_cast<HotkeyContext *>(argument);
+                    if (!self || !context || !self->BIOSCap || !self->YWMI)
+                        return kIOReturnNotReady;
+                    // Match hp-wmi: on a bezel notification, read query 0x0c.
+                    return self->WMIQuery(HPWMI_HOTKEY_QUERY, &context->keyCode,
+                                          HPWMI_READ, 0, sizeof(context->keyCode))
+                               ? kIOReturnSuccess
+                               : kIOReturnError;
+                },
+                &context);
+        }
+
+        ++hotkeyEventCount;
+        setProperty("HPWMIHotkeyEventCount", hotkeyEventCount, 32);
+        if (status == kIOReturnSuccess) {
+            setProperty("HPWMILastHotkeyCode", context.keyCode, 32);
+            setProperty("HPWMILastHotkeyName", context.keyCode == 0x270 ? "KEY_MICMUTE" : "other");
+            AlwaysLog("HP WMI hotkey code 0x%x%s", context.keyCode,
+                      context.keyCode == 0x270 ? " (KEY_MICMUTE)" : "");
+        } else {
+            setProperty("HPWMILastHotkeyRead", "failed");
+            AlwaysLog("HP WMI hotkey read failed (%x)", status);
+        }
+    } else
@@ -239,0 +271,36 @@ bool DYVPC::WMIQuery(UInt32 query, void *buffer, enum hp_wmi_command command, UI
+// HP's hp-wmi interface exposes fan RPM through GM query 0x11. Do not call
+// query 0x10 here: Linux documents that it can switch the firmware thermal
+// policy into a user-defined state. This implementation only reads fan 0.
+IOReturn DYVPC::readPlatformFanRPM(UInt32 fan, UInt32 &rpm, UInt8 *control) {
+    if (control)
+        *control = 0xff;
+    if (fan != 0)
+        return kIOReturnUnsupported;
+    if (!commandGate)
+        return kIOReturnNotReady;
+
+    struct FanReadContext {
+        UInt32 rpm{0};
+    } context;
+
+    const IOReturn status = commandGate->runAction(
+        [](OSObject *owner, void *argument, void *, void *, void *) -> IOReturn {
+            auto self = OSDynamicCast(DYVPC, owner);
+            auto context = static_cast<FanReadContext *>(argument);
+            if (!self || !context || !self->BIOSCap || !self->YWMI)
+                return kIOReturnNotReady;
+
+            UInt8 data[4] = {0, 0, 0, 0};
+            if (!self->WMIQuery(0x11, data, HPWMI_GM, sizeof(data[0]), sizeof(data)))
+                return kIOReturnError;
+
+            context->rpm = (static_cast<UInt32>(data[2]) << 8) | data[3];
+            return context->rpm <= 20000 ? kIOReturnSuccess : kIOReturnError;
+        },
+        &context);
+
+    if (status == kIOReturnSuccess)
+        rpm = context.rpm;
+    return status;
+}
+

+ IOLog("HPPIPE31 stage=%s tick=%llu ctl2=%08x fuse=%08x pipe=%08x trans=%08x plane=%08x htotal=%08x frame=%08x\n",
+       stage,mach_absolute_time(),ng->readReg32(0x45404),ng->readReg32(0x42000),
